# =============================================================================
# إعدادات بيئة الإنتاج لمدرسة نبراس القرآنية (Production Environment Variables)
# مسجد إبراهيم الخليل عليه السلام
# =============================================================================

# 1. إعدادات منصة Supabase (قاعدة البيانات والمصادقة والملفات):
# يمكن استخدام VITE_SUPABASE_PUBLISHABLE_KEY أو VITE_SUPABASE_ANON_KEY بالتبادل
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. إعدادات الذكاء الاصطناعي (Gemini API - اختياري):
VITE_GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# 3. معرفات وإعدادات النشر على Cloudflare Pages (تُضبط في GitHub Secrets أو لوحة Cloudflare):
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# CLOUDFLARE_PROJECT_NAME=nebras-quran
